# ============================================================
# ApraxTMail — configuration reference
# ============================================================
#
# The backend is a Cloudflare Worker (workers/). Configuration is split:
#
#  1. Non-secret vars  → workers/wrangler.toml [vars]
#  2. Secrets          → `npx wrangler secret put <NAME>` (never in git,
#                         never in the Android app, never in the frontend)
#  3. D1 / R2          → Cloudflare dashboard / wrangler commands (see
#                         docs/DEPLOYMENT.md)
#
# This file documents every knob. It is NOT read by the Worker at runtime.
# ============================================================

# --- Secrets (wrangler secret put NAME) ---

# HMAC secret for signing/verifying JWTs (HS256). ≥32 random chars.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Shared secret Emailit signs webhooks with (whsec_... from the Emailit
# dashboard → Webhooks). The endpoint returns 503 until this is set.
WEBHOOK_SECRET=

# Emailit API key (Bearer). Used to register domains, trigger verification,
# and fetch full inbound emails from GET /emails/{id}.
EMAILIT_API_KEY=

# --- Non-secret vars (workers/wrangler.toml [vars]) ---

# Public base URL of this Worker (no trailing slash).
PUBLIC_BASE_URL=https://aprax-tmail.<your-subdomain>.workers.dev

# Emailit API base (override only for testing).
EMAILIT_API_URL=https://api.emailit.com/v2

# Days an inbox message is kept before the cron job purges D1 rows + R2 objects.
MESSAGE_TTL_DAYS=30

# --- Cloudflare account (CI / wrangler auth, also secrets in GitHub Actions) ---
# CLOUDFLARE_API_TOKEN=   # token with Workers Edit + D1 edit + R2 edit
# CLOUDFLARE_ACCOUNT_ID=
