# ============================================================
# Aprax TMaii — Backend environment template
# Copy to .env (never commit .env) and fill in real values.
# The Android app NEVER sees these values.
# ============================================================

# --- Server ---
PORT=8080
APP_ENV=production
# Public base URL of this backend (used in docs/links, no trailing slash)
PUBLIC_BASE_URL=https://your-backend.example.com

# --- Database (PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/aprax_tmaii
DATABASE_USER=aprax
DATABASE_PASSWORD=change-me
DATABASE_MAX_POOL_SIZE=10

# --- Secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: openssl rand -base64 32  (used to encrypt provider mailbox tokens at rest)
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes-key
# Guest session lifetime in hours (default 72)
GUEST_SESSION_HOURS=72
# Account session lifetime in hours (default 720 = 30 days)
ACCOUNT_SESSION_HOURS=720

# --- Provider credentials (add real keys here; leave blank to disable a provider) ---
FCE_API_KEY=
TMAILOR_API_KEY=

# Provider toggles (true/false). A missing API key also disables that provider.
FCE_ENABLED=true
TMAILOR_ENABLED=true

# Tmailor free plan requires your server's outbound IP to be allowlisted
# in the Tmailor dashboard. Leave blank to skip the startup IP check.
TMAILOR_EXPECTED_IP=

# --- Admin bootstrap (first admin is created on startup if none exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Abuse prevention ---
# Global requests per second per client IP (default 5)
RATE_LIMIT_RPS=5
# Guest mailboxes per hour (default 10)
GUEST_MAILBOX_LIMIT=10
# Account mailboxes per hour (default 30)
ACCOUNT_MAILBOX_LIMIT=30

# --- CORS (comma-separated origins; admin dashboard origin) ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
